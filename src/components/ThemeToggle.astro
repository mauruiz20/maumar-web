---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<button type="button" id="theme-toggle" class="theme-toggle" aria-pressed="false">
  <span class="dot" aria-hidden="true"></span>{label}
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 0.25rem;
    border: 0;
    background: none;
    color: var(--muted);
    font: inherit;
    font-size: var(--step--1);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--ink);
  }

  .dot {
    width: 0.8rem;
    height: 0.8rem;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
  }

  .theme-toggle[aria-pressed='true'] .dot {
    background: currentColor;
  }
</style>
