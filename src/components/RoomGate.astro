---
import type { Content } from '../content/profile';

interface Props {
  content: Content;
}
const { room } = Astro.props.content;
---

<div id="room-root" class="room-root" role="region" aria-label={room.label} tabindex="-1" hidden>
  <button type="button" class="room-exit" data-room-exit>{room.exit}</button>
  <div class="room-host" data-room-app></div>
  <div class="room-loading">
    <p class="room-loading-text">{room.loading}</p>
    <span class="room-loading-bar" aria-hidden="true"></span>
  </div>
</div>

<script>
  import { initRoomGate } from '../room/boot';
  initRoomGate();
</script>
